# This file will automatically update with entries for new content after a build and reload.

Mods: {
	DynamicWorlds: {
		Items: {
			RealityAnchor: {
				DisplayName: Reality Anchor
				Tooltip:
					'''
					Left-click a tile to anchor it. Click again to unanchor.
					Click and drag to anchor or unanchor a whole area at once.
					Anchored tiles survive every world regeneration — terrain, walls, wires, and liquids included.
					Containers (chests, dressers) also remember their contents when anchored.
					Anchor your bed to keep your spawn point after a regen.
					Tiles inside structure zones cannot be anchored separately.
					Right-click in your inventory to manually restore all anchored tiles at any time.
					Hold any world tool to see anchors, erasures, structure zones, and Biome Dowser zones highlighted in the world.
					There is a limit to how many tiles you can anchor — anchor what matters most.
					'''
			}

			RealityEraser: {
				DisplayName: Reality Eraser
				Tooltip:
					'''
					Left-click a tile to mark it for erasure. Click again to unmark.
					Click and drag to mark or unmark a whole area at once.
					Marked tiles are cleared to empty space after every world regeneration.
					Erasure happens before anchored tiles are restored, so anchors always win.
					Right-click in your inventory to erase all marked tiles immediately.
					Hold any world tool to see anchors, erasures, structure zones, and Biome Dowser zones highlighted in the world.
					The erasure limit is much higher than the anchor limit.
					'''
			}

			StructureAnchorItem: {
				DisplayName: Structure Anchor
				Tooltip:
					'''
					Click and drag to define a protected structure zone.
					Drag again to add more separate structure zones to the world.
					All tiles inside each zone are saved and restored after every world regen.
					Each structure is translated up or down so its base sits at the new ground level.
					Small gaps beneath a restored structure are bridged, but floating islands stay floating.
					Zones on different anchors cannot overlap — each tile belongs to one zone only.
					Structure zones cannot overlap individually anchored tiles.
					Hold any world tool to see anchors, erasures, structure zones, and Biome Dowser zones highlighted in the world.
					Shift-click inside a structure zone to remove it.
					'''
			}

			BiomeDowser: {
				DisplayName: Biome Dowser
				Tooltip:
					'''
					Click and drag to define a biome-aware pylon relocation zone.
					Each zone must fully contain exactly one vanilla pylon.
					Only tiles connected to that pylon inside the selected area are saved and moved.
					Open the Biome Dowser settings to choose surface, underground, floating, sky, and ocean preferences per pylon.
					Only compatible pylons can use each preference, and unsupported modes fall back automatically.
					On regen, the saved structure is rebuilt in a biome where that pylon can function.
					Biome Dowser zones cannot overlap structure zones or individually anchored tiles.
					Hold any world tool to see anchors, erasures, structure zones, and Biome Dowser zones highlighted in the world.
					Shift-click inside a Biome Dowser zone to remove it.
					'''
			}
		}
	}
}

